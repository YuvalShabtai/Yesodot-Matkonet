// מוסיף סיסמה חדשה אם אינה קיימת כבר במערך.
public static bool GetPass(int[] arr, int password)
{
    // בדיקה האם הסיסמה כבר קיימת
    for (int i = 0; i < arr.Length; i++)
    {
        if (arr[i] == password)
            return false;
    }

    // הזזת כל הסיסמאות תא אחד ימינה
    for (int i = arr.Length - 1; i > 0; i--)
    {
        arr[i] = arr[i - 1];
    }

    // הכנסת הסיסמה החדשה לתחילת המערך
    arr[0] = password;

    return true;
}
