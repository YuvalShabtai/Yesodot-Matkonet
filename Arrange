// תרגיל 3 – סידור חיוביים ושליליים
// מעביר את כל החיוביים לתחילת המערך ואת השליליים לסופו.
// =========================

// מסדר את המערך תוך שמירה על הסדר המקורי.
public static void Arrange(int[] arr)
{
    int counter = 0;

    // מערך עזר לסידור מחדש
    int[] temp = new int[arr.Length];

    // הכנסת כל המספרים החיוביים והאפס
    for (int i = 0; i < arr.Length; i++)
    {
        if (arr[i] >= 0)
        {
            temp[counter] = arr[i];
            counter++;
        }
    }

    // הכנסת כל המספרים השליליים
    for (int i = 0; i < arr.Length; i++)
    {
        if (arr[i] < 0)
        {
            temp[counter] = arr[i];
            counter++;
        }
    }

    // העתקת המערך החדש למערך המקורי
    for (int i = 0; i < arr.Length; i++)
    {
        arr[i] = temp[i];
    }
}
